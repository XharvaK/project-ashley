FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY apps/agent-service/package*.json ./apps/agent-service/
RUN cd apps/agent-service && npm ci
COPY apps/agent-service ./apps/agent-service
COPY workspace ./workspace
RUN cd apps/agent-service && npm run build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/apps/agent-service/package*.json ./apps/agent-service/
RUN cd apps/agent-service && npm ci --omit=dev
COPY --from=build /app/apps/agent-service/dist ./apps/agent-service/dist
COPY --from=build /app/workspace ./workspace
ENV NODE_ENV=production
ENV COMPOSER_WORKSPACE=/app/workspace
ENV COMPOSER_DATA_DIR=/data
EXPOSE 3710
CMD ["node", "apps/agent-service/dist/index.js"]
