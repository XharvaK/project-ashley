FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY apps/discord-bot/package*.json ./apps/discord-bot/
RUN cd apps/discord-bot && npm ci
COPY apps/discord-bot ./apps/discord-bot
RUN cd apps/discord-bot && npm run build

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/apps/discord-bot/package*.json ./apps/discord-bot/
RUN cd apps/discord-bot && npm ci --omit=dev
COPY --from=build /app/apps/discord-bot/dist ./apps/discord-bot/dist
ENV NODE_ENV=production
CMD ["node", "apps/discord-bot/dist/index.js"]
