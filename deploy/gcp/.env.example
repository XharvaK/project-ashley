# Copy to deploy/gcp/.env on the VM — never commit.

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_REASONING_EFFORT=none
MISTRAL_CHAT_TEMPERATURE=0.55
MEMORY_CONSOLIDATION_MODEL=mistral-small-latest
MEMORY_EMBED_MODEL=mistral-embed

DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ALLOWED_CHANNELS=
DISCORD_GUILD_ID=

MEMORY_OWNER_ID=

AUTO_REMEMBER_ENABLED=true
PROACTIVE_ENABLED=true
PROACTIVE_MAX_PER_DAY=4
PROACTIVE_MIN_IDLE_HOURS=2
PROACTIVE_CHECK_INTERVAL_MIN=20

AGENT_PORT=3710
# discord-bot container talks to agent service name on Docker network
AGENT_SERVICE_URL=http://agent:3710
