[Unit]
Description=Ashley execution broker
Requires=ashley-exec-broker.socket
After=ashley-exec-broker.socket
ConditionPathExists=/opt/ashley-sandbox/dist/main.js

[Service]
Type=simple
User=ashley-sandbox
Group=ashley-sandbox
WorkingDirectory=/var/lib/ashley-sandbox
EnvironmentFile=-/etc/ashley-sandbox/broker.env
ExecStart=@NODE@ /opt/ashley-sandbox/dist/main.js --socket-activated
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectProc=invisible
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# 02C: the physical Bubblewrap profile requires the full host namespace
# prerequisite set. Bubblewrap explicitly unshares pid, net, uts, and ipc;
# user and mount remain host prerequisites for the provider boundary.
RestrictNamespaces=user mount pid net uts ipc
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
MemoryMax=384M
TasksMax=64
CPUQuota=100%
ReadOnlyPaths=/opt/ashley-sandbox
ReadWritePaths=/var/lib/ashley-sandbox

[Install]
WantedBy=multi-user.target
