[Unit]
Description=Ashley telegram-bot (disabled by default on Mint)
After=network-online.target ashley-agent.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/composer-assistant/apps/telegram-bot
EnvironmentFile=%h/.composer-assistant/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
MemoryMax=256M

[Install]
# Disabled by default — do not enable until Discord acceptance is done
# WantedBy=default.target
