# Copy to ~/.composer-assistant/.env — never commit real keys

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_REASONING_EFFORT=none
# Mistral documents 0.0 to 0.7; chat is clamped to 0.7 in code
MISTRAL_CHAT_TEMPERATURE=0.65
MISTRAL_CHAT_PRESENCE_PENALTY=0.15
MISTRAL_VOICE_TEMPERATURE=0.5
MISTRAL_RECALL_TEMPERATURE=0.3
MEMORY_CONSOLIDATION_MODEL=mistral-small-latest
MEMORY_EMBED_MODEL=mistral-embed

DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ALLOWED_CHANNELS=
DISCORD_GUILD_ID=

# Telegram (Ashley bot — BotFather token, not Telethon user API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Telethon study harness (user client to @OrchidHQBot)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

MEMORY_OWNER_ID=

# Memory / auto-remember
MEMORY_HOT_MAX_MESSAGES=48
MEMORY_HOT_MAX_TOKENS=12000
MEMORY_VOICE_HOT_MESSAGES=8
MEMORY_SUMMARY_BATCH=16
# Turns kept verbatim behind the summary cutoff, so summarizing never eats the
# recent conversation
MEMORY_SUMMARY_RESIDUAL_FLOOR=24
MEMORY_FACT_EVERY_N=4
AUTO_REMEMBER_ENABLED=true
MEMORY_JOBS_PENDING_ALERT=50
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_RETRIEVAL_MIN_SCORE=0.35

AGENT_PORT=3710
AGENT_BIND_HOST=127.0.0.1
AGENT_SERVICE_URL=http://127.0.0.1:3710

# Proactive DM outreach (default on; set false to disable)
PROACTIVE_ENABLED=true
PROACTIVE_CHANNEL=discord
PROACTIVE_MAX_PER_DAY=8
PROACTIVE_MIN_IDLE_HOURS=2
PROACTIVE_CHECK_INTERVAL_MIN=20
PROACTIVE_COLD_START_HOURS=24
# Material queue: score floor, and how long silence must run to be worth naming
PROACTIVE_MIN_SCORE=20
PROACTIVE_CHECKIN_IDLE_HOURS=20
# Burst rhythm: a few close together, then a long rest
PROACTIVE_BURST_MAX=3
PROACTIVE_BURST_WINDOW_MINUTES=90
PROACTIVE_BURST_GAP_MINUTES=12
PROACTIVE_BURST_REST_MINUTES=150
# Silence backoff: each ignored message buys the next a longer wait
PROACTIVE_MAX_UNANSWERED=4
PROACTIVE_BACKOFF_STEP_HOURS=1.5
# Mid-thread nudge: only inside a live session, only when her last word is stale
PROACTIVE_SESSION_WINDOW_HOURS=3
PROACTIVE_NUDGE_IDLE_MINUTES=25

# Local habits / quiet hours (Europe/Istanbul)
DOC_TIMEZONE=Europe/Istanbul
QUIET_HOURS_START=23:30
QUIET_HOURS_END=07:30

# Discord messenger media (Orchid-craft GIFs). Giphy preferred; Tenor optional fallback.
GIPHY_API_KEY=
TENOR_API_KEY=
GIF_ENABLED=true
GIF_COOLDOWN_SEC=120

# Persona: friction dial (high|normal|off), durable opinions, voice examples
ASHLEY_FRICTION=high
STANCE_LEDGER_ENABLED=true
STANCE_EVERY_N=6
PERSONA_FEWSHOT_ENABLED=true
PERSONA_FEWSHOT_COUNT=4

# Curiosity loop: her own reading. Scans wide, notes a few, reads almost none.
CURIOSITY_ENABLED=true
CURIOSITY_TICK_MINUTES=45
CURIOSITY_SOURCES_PER_TICK=2
CURIOSITY_SOURCE_INTERVAL_HOURS=6
CURIOSITY_ITEMS_PER_SOURCE=12
CURIOSITY_NOTE_PER_DAY=12
CURIOSITY_READ_PER_DAY=3
# How often her reading may surface in chat at all, per day
CURIOSITY_SURFACE_PER_DAY=2
# Mid-chat lookups + watches (shared 1000 credits/month)
TAVILY_API_KEY=
CURIOSITY_LOOKUP_ENABLED=true
CURIOSITY_TAVILY_MONTHLY_CREDITS=1000
# Optional daily burst smoother; monthly ceiling stays authoritative
CURIOSITY_LOOKUP_PER_DAY=40
# Doc-supplied page reads (direct fetch, not Tavily)
CURIOSITY_LINK_READ_PER_DAY=8
CURIOSITY_WATCH_MAX=3
CURIOSITY_WATCH_CADENCE_HOURS=24

# Delivery: human gaps between her bubbles, sparing anti-mirror reactions.
# Opt in with "true" only.
DISCORD_PACE_ENABLED=false
DISCORD_REACT_POLICY_ENABLED=false
