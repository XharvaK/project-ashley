# Copy to ~/.composer-assistant/.env — never commit real keys
# Labels: [agent] read by the agent service; [broker] read by the execution
# broker host unit (Mint /etc/ashley-sandbox/broker.env); [both] shared.

# ── Providers [agent] ────────────────────────────────────────────────────────
# Required at boot: Mistral (primary Expression lane) and Groq (Thought /
# utility_bulk / expression fallback). NVIDIA NIM routes are optional: they are
# represented in config/models.json but remain DISABLED and never dispatch.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_REASONING_EFFORT=none
MISTRAL_CHAT_TEMPERATURE=0.65
# Copy the current organization/model limits from Mistral Studio.
MISTRAL_REQUESTS_PER_SECOND=1
MISTRAL_TOKENS_PER_MINUTE=100000

# Groq (utility_bulk / Thought / expression fallback)
# Routes: expression->ashley_expression (mistral); thought->thought (groq 120B);
# exchange_cognition/curiosity_consolidation/thought_observation/maintenance->utility_bulk (groq 20B).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b

# NVIDIA NIM (optional, DISABLED — never routed; no key required at boot).
# NIM_API_KEY=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional override; defaults to the current Git commit when available.
ASHLEY_RELEASE_ID=

# ── Discord [agent] ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ALLOWED_CHANNELS=
DISCORD_GUILD_ID=

MEMORY_OWNER_ID=

AGENT_PORT=3710
AGENT_BIND_HOST=127.0.0.1
AGENT_SERVICE_URL=http://127.0.0.1:3710

# ── Nuclear Identity→State→Agency (nuclear.db) [agent] ───────────────────────
PROACTIVE_ENABLED=true
PROACTIVE_MAX_PER_DAY=8
PROACTIVE_MIN_IDLE_HOURS=2
ASHLEY_REFLECTION_MODE=observe
ASHLEY_COGNITION_MODE=observe
COGNITION_DISPATCH_INTERVAL_SEC=30
COGNITION_IDLE_CONSOLIDATION_MIN=10
# Discord bot scheduler poll interval (minutes)
PROACTIVE_CHECK_INTERVAL_MIN=20

CURIOSITY_ENABLED=true
CURIOSITY_TICK_MINUTES=45
CURIOSITY_ITEMS_PER_SOURCE=12

GIPHY_API_KEY=
TENOR_API_KEY=
GIF_ENABLED=true
GIF_COOLDOWN_SEC=90

# ── Visible Expression fallback (Wave 3, active) [agent] ──────────────────────
# When the primary Mistral dispatch fails on an eligible turn, retry once via
# the minimal-profile ashley_expression_fallback (Groq) route. ON by default;
# set false to opt out.
# ASHLEY_EXPRESSION_FALLBACK=false
# ASHLEY_EXPRESSION_FALLBACK_RECENT_TURNS=6
# Decision kinds that must never leave the Mistral lane (comma-separated).
# ASHLEY_EXPRESSION_MISTRAL_ONLY_KINDS=

# ── Sandbox: agent-side signing keys and broker IPC [agent] ──────────────────
# Paths only; never put private keys here. The agent signs owner approvals and
# tombstones with the encrypted PEMs under ASHLEY_SANDBOX_KEYS_DIR.
# Enabling the sandbox (ASHLEY_SANDBOX_BROKER_ENABLED=true) makes boot
# readiness fail closed until every dependency below exists and every
# [broker] trust anchor is present. Disabled sandbox requires none of these.
# ASHLEY_SANDBOX_BROKER_ENABLED=false
# ASHLEY_SANDBOX_BROKER_SOCKET=/run/ashley/broker.sock
# ASHLEY_SANDBOX_BROKER_TIMEOUT_MS=5000
# ASHLEY_SANDBOX_KEYS_DIR=~/.composer-assistant/keys
# ASHLEY_SANDBOX_KEY_PASSPHRASE_PATH=~/.composer-assistant/keys/master.pass
# ASHLEY_SANDBOX_OWNER_KEY_ENC_PATH=~/.composer-assistant/keys/owner-approval.key.enc
# ASHLEY_SANDBOX_CONTINUITY_KEY_ENC_PATH=~/.composer-assistant/keys/continuity-tombstone.key.enc
# ASHLEY_SANDBOX_OWNER_KEY_ID=owner-ed25519-v1
# ASHLEY_SANDBOX_CONTINUITY_KEY_ID=continuity-tombstone-ed25519-v1

# ── Sandbox: capability lifecycle and network (readiness-gated) [agent] ──────
# Lifecycle mirrors the autonomy gate values; the runtime loop stays
# constructor-injected and defaults to disabled. Any value other than
# "disabled" requires full sandbox readiness at boot.
# ASHLEY_SANDBOX_LIFECYCLE=disabled
# Network isolation for fixed recipes: "unavailable" (fail-closed, default) or
# "none" (Mint network-namespace enforcement).
# ASHLEY_SANDBOX_NETWORK_PROVIDER=unavailable
# ASHLEY_SANDBOX_MAX_CONCURRENT_TASKS=1

# ── Sandbox: policy artifacts and delegated key material [agent] ─────────────
# Signed policy document (JSON) + its detached signature. The delegated
# runtime key is injected as material; these paths document custody.
# ASHLEY_SANDBOX_POLICY_ARTIFACT=~/.composer-assistant/sandbox/policy.json
# ASHLEY_SANDBOX_POLICY_SIGNATURE=~/.composer-assistant/sandbox/policy.json.sig
# ASHLEY_SANDBOX_DELEGATED_KEY_ENC_PATH=~/.composer-assistant/keys/delegated-runtime.key.enc
# ASHLEY_SANDBOX_DELEGATED_KEY_ID=delegated-runtime-ed25519-v1
# ASHLEY_SANDBOX_CAPABILITY_KEY_ENC_PATH=~/.composer-assistant/keys/broker-session-capability.key.enc
# ASHLEY_SANDBOX_CAPABILITY_KEY_ID=broker-session-capability-ed25519-v1
# ASHLEY_SANDBOX_STATE_ROOT=~/.composer-assistant/sandbox/state
# ASHLEY_SANDBOX_WORKSPACE_ROOT=~/.composer-assistant/sandbox/workspace

# ── Sandbox: broker host unit (Mint /etc/ashley-sandbox/broker.env) [broker] ─
# Read by the execution broker systemd service, not by the agent. Required
# when the broker is installed: uid, roots, owner identity, public key paths,
# and the peer-credential helper. Never put private keys here.
# ASHLEY_SANDBOX_AGENT_UID=1000
# ASHLEY_SANDBOX_STATE_ROOT=/var/lib/ashley-sandbox/state
# ASHLEY_SANDBOX_WORKSPACE_ROOT=/var/lib/ashley-sandbox/workspace
# ASHLEY_SANDBOX_OWNER_ID=owner
# ASHLEY_SANDBOX_OWNER_PUBLIC_KEY=/var/lib/ashley-sandbox/keys/owner-approval.pub
# ASHLEY_SANDBOX_CONTINUITY_PUBLIC_KEY=/var/lib/ashley-sandbox/keys/continuity-tombstone.pub
# ASHLEY_SANDBOX_RECIPE_MANIFEST=/etc/ashley-sandbox/recipes.json
# ASHLEY_SANDBOX_PEER_CREDENTIAL_HELPER=/opt/ashley-sandbox/peer-credentials-helper
# ASHLEY_SANDBOX_OWNER_KEY_ID=owner-ed25519-v1
# ASHLEY_SANDBOX_CONTINUITY_KEY_ID=continuity-tombstone-ed25519-v1
# ASHLEY_SANDBOX_SOCKET=/run/ashley/broker.sock

DISCORD_PACE_ENABLED=true
DISCORD_REACT_POLICY_ENABLED=true
